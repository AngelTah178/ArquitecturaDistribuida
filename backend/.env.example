# Configuración General del Servidor
APP_NAME="Arquitectura Distribuida UPQROO"
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Configuración de Clusters MongoDB Atlas
# Cluster #1 (Rango de 1 a 3 usuarios activos)
MONGO_CLUSTER_1_URI=mongodb+srv://developer1:password123@cluster1.mongodb.net/?retryWrites=true&w=majority
# Cluster #2 (Rango de 4 a 6 usuarios activos)
MONGO_CLUSTER_2_URI=mongodb+srv://developer1:password123@cluster2.mongodb.net/?retryWrites=true&w=majority
# Cluster #3 (Rango de 7 a 9 usuarios activos)
MONGO_CLUSTER_3_URI=mongodb+srv://developer1:password123@cluster3.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=upqroo_distribuida

# Configuración de PostgreSQL (Neon Cloud)
POSTGRES_NEON_URI=postgresql://dev1:password123@ep-cool-neon.us-east-2.aws.neon.tech/upqroo_distribuida?sslmode=require

# Configuración de Scheduler ETL
SYNC_INTERVAL_MINUTES=3

# Simulación / Modo Mock para pruebas locales sin conexión Cloud inmediata
ENABLE_MOCK_FALLBACK=True
